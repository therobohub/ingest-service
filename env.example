# RoboHub Ingest Service Configuration

# HTTP Server
PORT=8081

# Database
DATABASE_URL=postgres://robohub:robohub@localhost:5432/robohub_ingest?sslmode=disable

# JWT Authentication
# IMPORTANT: Change this in production!
ROBOHUB_JWT_SECRET=dev-secret-change-in-production

# Clock skew tolerance for JWT validation (seconds)
ROBOHUB_CLOCK_SKEW_SECONDS=60

# Rate Limiting
ROBOHUB_RATE_LIMIT_RPS=10
ROBOHUB_RATE_LIMIT_BURST=20

# Request size limits
ROBOHUB_MAX_BODY_BYTES=262144
